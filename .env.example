# ── Copy this file to .env and fill in the values ──────────────────────────
# .env is gitignored and never committed — this file is safe to commit.

# MySQL root password (choose something strong)
MYSQL_ROOT_PASSWORD=your_strong_mysql_password_here

# JWT secret — must be identical in BOTH Spring Boot services
# Use a long random string, e.g.: openssl rand -base64 32
JWT_SECRET=your_very_long_random_jwt_secret_here

# Comma-separated list of Angular frontend URLs allowed by CORS
# For local docker-compose: http://localhost
# For production: https://your-deployed-angular-url.com
ALLOWED_ORIGINS=http://localhost

# Gmail SMTP — use a Gmail App Password (not your regular password)
# Google Account → Security → 2-Step Verification → App passwords
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
